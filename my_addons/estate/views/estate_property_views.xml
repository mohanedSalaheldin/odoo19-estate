<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="real_estate_view_search" model="ir.ui.view">
        <field name="name">real.estate.view.search</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="state" />
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <filter name="available" string="Available" domain="[('state', 'in', ('new', 'offer_received'))]" />
                <filter name="filter_state_name" string="New" domain="[('state', '=', 'new')]" />
                <filter name="filter_state_offer_received" string="Offer Received" domain="[('state', '=', 'offer_received')]" />
                <filter name="group_by_postcode" string="Postcode" context="{'group_by':'postcode'}" />
            </search>
        </field>
    </record>
    <record id="real_estate_view_form" model="ir.ui.view">
        <field name="name">real.estate.view.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form string="Property Details">
                <header>
                    <button name="action_sold" type="object" string="Sold" invisible="state in ('sold', 'canceled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('sold', 'canceled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                    </div>
                    <group>
                        <group>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <field name="property_type_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="expected_price" widget="monetary"/>
                            <field name="selling_price" widget="monetary"/>
                            <field name="best_price" widget="monetary"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="garage" widget="boolean_toggle"/>
                                    <field name="garden" widget="boolean_toggle"/>
                                    <field name="garden_orientation" widget="radio" invisible="not garden"/>
                                    <field name="garden_area" invisible="not garden"/>
                                    <field name="living_area"/>
                                    <field name="total_area"/>
                                </group>
                            </page>
                            <page string="Other Info">
                                <group>
                                    <field name="salesperson_id"/>
                                    <field name="buyer_id"/>
                                </group>
                            </page>
                            <page string="Offers">
                                <field name="offer_ids" readonly="state in ('offer_accepted', 'sold', 'canceled')">
                                    <list editable="bottom">
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                        <field name="status"/>
                                        <button name="action_accept" invisible="status" type="object" icon="fa-check" string="Accept"/>
                                        <button name="action_refuse" invisible="status" type="object" icon="fa-times" string="Refuse"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="real_estate_view_list" model="ir.ui.view">
        <field name="name">real.estate.view.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-success="state in ('offer_received', 'offer_accepted')"
              decoration-bf="state == 'offer_accepted'"
              decoration-muted="state == 'sold'">
                <field name="name" string="Title"/>
                <field name="property_type_id"/>
                <field name="postcode" string="Postcode"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living Area" optional="hide"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="selling_price" string="Selling Price"/>
                <field name="date_availability" string="Date Availability" optional="hide"/>
                <field name="state" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="real_estate_action" model="ir.actions.act_window">
        <field name="name">Estate</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': True}</field>
    </record>
</odoo>